# Copy to .env and fill in.

# --- AI (pick ONE) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# --- Telegram ---
# Create bot via @BotFather, get token.
# Get your chat_id by messaging @userinfobot on Telegram.
TELEGRAM_BOT_TOKEN=1234567:ABC...
TELEGRAM_ADMIN_CHAT_ID=123456789

# --- Google Sheets ---
# The spreadsheet where upload events are logged.
# From the sheet's URL: docs.google.com/spreadsheets/d/<THIS_PART>/edit
SHEETS_SPREADSHEET_ID=1AbCdEf...
SHEETS_TOKEN_FILE=tokens/token_sheets.json

# --- Drive (shared submissions account token) ---
DRIVE_TOKEN_FILE=tokens/token_drive.json

# --- Misc ---
# LOG_LEVEL=INFO
# DRY_RUN=1   # uncomment to run bot without touching Google / YouTube
